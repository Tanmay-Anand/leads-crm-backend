# Values for the `local` Spring profile. Spring Boot does not read this file automatically —
# source it into the process environment before running the app, e.g.
#   set -a && source .env && set +a && ./mvnw spring-boot:run
# or wire it via an IntelliJ run-config EnvFile plugin.

APP_DB_PORT=5433
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=postgres

# AWS Cognito — the user pool whose JWTs this API accepts.
# issuer-uri is derived as https://cognito-idp.${AWS_REGION}/${AWS_COGNITO_USER_POOL_ID}
AWS_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# ── AI Query SDK ──────────────────────────────────────────────────────────────
# This is genuinely everything the SDK needs from the host to boot ready-to-use — everything
# else (entities, fields, relationships, guardrails, meetings, whatsapp) is its own runtime
# config on /ai-sdk/configure and /ai-sdk/settings, not env vars here.
AI_SDK_JWT_SECRET=change-me-to-a-long-random-secret
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
AI_SDK_LLM_PLANNER_MODEL=inclusionai/ling-3.0-flash-vl:free
AI_SDK_LLM_SUMMARIZER_MODEL=inclusionai/ling-3.0-flash-vl:free
AI_SDK_LICENSE_KEY=your-license-key
AI_SDK_ALLOWED_ORIGIN=http://localhost:5173

# Optional. Setting this skips the interactive OTP -> /ai-sdk/setup dance entirely: the admin
# password is synced from here on every boot, so a fresh clone (or a fresh container) is
# immediately ready to authenticate against without anyone visiting a setup page by hand. At
# least 12 characters. Leave unset to keep using the one-time OTP flow instead (logged at WARN
# on first start). scripts/provision-ai-sdk.sh reads this too.
AI_SDK_ADMIN_PASSWORD=

# ── Meeting reminder emails ─────────────────────────────────────────────────────
# SMTP used to send the assignee the 1h/10m/2m pre-meeting emails. Leave unset in local dev —
# JavaMailSender just logs a warning per failed send instead of blowing up the reminder job.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
