# Copied to /opt/leads-crm/.env on the host and never committed.
# The deploy workflow rewrites API_IMAGE; everything else is set once at provisioning time.

API_IMAGE=481310453532.dkr.ecr.ap-south-1.amazonaws.com/leads-crm-backend:latest

# From scripts/provision-rds.sh.
APP_DB_HOST=leads-crm-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
APP_DB_NAME=leadscrm
APP_DB_USERNAME=leadscrm
# The password is NOT here. start.sh reads it from this secret using the instance role, so it
# never lands on the filesystem.
APP_DB_SECRET_ARN=

AWS_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Only consulted when the browser calls the API directly, which it does not while the frontend
# reaches it through the Amplify proxy. Set it if you move to a CloudFront origin.
APP_CORS_ORIGINS=
