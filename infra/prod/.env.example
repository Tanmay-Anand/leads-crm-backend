# Copied to /opt/leads-crm/.env on the host and never committed.
# The deploy workflow rewrites API_IMAGE; everything else is set once at provisioning time.

API_IMAGE=481310453532.dkr.ecr.ap-south-1.amazonaws.com/leads-crm-backend:latest

# From scripts/provision-rds.sh.
APP_DB_HOST=leads-crm-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
APP_DB_NAME=leadscrm
APP_DB_USERNAME=leadscrm
# The password is NOT here. start.sh reads it from this secret using the instance role, so it
# never lands on the filesystem.
APP_DB_SECRET_ARN=

AWS_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Comma-separated origins or wildcard patterns the browser may call this API from. Leave it
# unset to use WebSecurityConfig's defaults, which already cover the deployed frontend and its
# Vercel preview deployments.
#
# It is NOT safe to assume the proxy makes this irrelevant. Requests reaching the API through a
# same-origin rewrite still carry an Origin header on POST, PUT, PATCH and DELETE — browsers omit
# it only on same-origin GET — so an empty allow-list lets every page load and fails every write
# with a bare 403.
APP_CORS_ORIGINS=

# ── AI Query SDK ──────────────────────────────────────────────────────────────
# AI_SDK_JWT_SECRET and OPENROUTER_API_KEY are the only two placeholders in
# application.yaml with no default, so the container exits on boot without them:
#
#   PlaceholderResolutionException: Could not resolve placeholder 'OPENROUTER_API_KEY'
#
# That leaves nginx with no upstream and every request answering 502. The ai-sdk module
# arrived after this file was first written and these were never added to it, so a host
# .env created from an earlier copy needs both lines appended by hand.
AI_SDK_JWT_SECRET=
# A fixed OTP so the setup token stays the same across reboots and volume wipes. Without it the
# SDK generates a random one each boot and prints it to the logs. configure-host.sh generates a
# stable value on first run — copy it here if you need to set it by hand.
AI_SDK_OTP=
OPENROUTER_API_KEY=

# Defaulted in application.yaml, but the default origin is http://localhost:5173, which is
# wrong anywhere but a dev box. Set it to the Amplify origin or the in-CRM AI widget's calls
# are rejected.
AI_SDK_ALLOWED_ORIGIN=

# AI_SDK_LLM_PLANNER_MODEL, AI_SDK_LLM_SUMMARIZER_MODEL and AI_SDK_LICENSE_KEY are left out on
# purpose. They are defaulted in application.yaml and are not in docker-compose.yml's
# `environment:` allowlist, because an unset key would reach Spring as an empty string and
# override the default with "". To pin a model, add it here AND to that allowlist.
#
# AI_SDK_SQLITE_PATH is set in docker-compose.yml, pointing at the named volume that keeps the
# ai-sdk admin password alive across deploys.
