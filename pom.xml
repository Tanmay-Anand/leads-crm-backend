<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.leadrat.crm.leads</groupId>
	<artifactId>leads-crm-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>leads-crm-backend</name>
	<description>Leads CRM API - Leads, Projects, Channel Partners</description>

	<properties>
		<java.version>21</java.version>
		<lombok.version>1.18.38</lombok.version>
		<libphonenumber.version>9.0.19</libphonenumber.version>
		<springdoc.version>2.8.14</springdoc.version>
		<commons-validator.version>1.10.0</commons-validator.version>
		<jib.version>3.5.1</jib.version>
		<aws-sdk.version>2.29.29</aws-sdk.version>
		<caffeine.version>3.1.8</caffeine.version>
		<!-- Overridden by CI to point at ECR. Locally this builds an image into the Docker daemon. -->
		<docker.image.prefix>leads-crm</docker.image.prefix>
		<docker.architecture>amd64</docker.architecture>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws-sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!--	Web	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>

		<!--	Jpa	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!--	Security — Cognito JWT resource server	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!--	Validation	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-validator</groupId>
			<artifactId>commons-validator</artifactId>
			<version>${commons-validator.version}</version>
		</dependency>

		<!--	AOP — TenantFilterAspect. Boot 4 dropped the aop starter, so the weaver is declared
		        directly; spring-aop itself arrives with spring-context.	-->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>

		<!--	Actuator	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--	Mail — meeting reminder emails	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!--	Phone number normalisation — LeadIdentity	-->
		<dependency>
			<groupId>com.googlecode.libphonenumber</groupId>
			<artifactId>libphonenumber</artifactId>
			<version>${libphonenumber.version}</version>
		</dependency>

		<!--	OpenAPI	-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--	Database	-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--	Tooling	-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.jetbrains</groupId>
			<artifactId>annotations</artifactId>
			<version>26.0.2</version>
			<scope>provided</scope>
		</dependency>

		<!--	AWS Cognito admin API — user provisioning for the User Management module.
			Excludes the SDK's default async HTTP clients (netty-nio-client pulls in Netty,
			apache-client pulls in Apache HttpClient) in favour of the lighter synchronous
			url-connection-client below, since this app only ever makes occasional admin
			calls, never high-throughput ones.	-->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>cognitoidentityprovider</artifactId>
			<exclusions>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>

		<!--	Permission-check caching (PermissionCache) - held directly, not through
			spring-boot-starter-cache, since eviction needs tenant-prefix eviction that
			Spring's Cache abstraction (evict(key)/clear() only) cannot express.	-->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
			<version>${caffeine.version}</version>
		</dependency>

		<!--	AI Query SDK. Resolved via JitPack (see <repositories> below), not GitHub
			Packages: GitHub Packages requires auth on every request even for a public
			repo, and the pom's own published coordinates (com.leadrat:ai-query-sdk)
			point at a distributionManagement URL the publish workflow never actually
			used (it overrides github.owner/github.repo to the real repo at publish
			time, and no version has ever been tagged/published there). JitPack builds
			straight from the source repo instead - no auth, no publish step, and it
			works off a commit SHA before any tag exists. Coordinates are always
			com.github.<owner>:<repo>, independent of the source project's own
			internal Maven coordinates. Pin to a tag once one exists; a commit SHA is
			the safe default until then, since it cannot be redefined out from under
			this build the way a floating branch could.	-->
		<dependency>
			<groupId>com.github.anshikleadrat</groupId>
			<artifactId>sales-sdk</artifactId>
			<version>0abb2b9ba3d6623aff863c83d8b8f59a9412f892</version>
		</dependency>

		<!--	Test	-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!--	Container image, as in platform-api: Jib rather than a Dockerfile, so the image
			        layers on dependencies and classes separately and a code-only change ships a
			        few hundred KB instead of the whole fat jar.	-->
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<version>${jib.version}</version>
				<configuration>
					<from>
						<image>public.ecr.aws/amazoncorretto/amazoncorretto:21-al2023-jdk</image>
						<platforms>
							<platform>
								<os>linux</os>
								<!-- The build runner is amd64; override for an arm64 instance. -->
								<architecture>${docker.architecture}</architecture>
							</platform>
						</platforms>
					</from>
					<to>
						<image>${docker.image.prefix}/${project.artifactId}:${project.version}</image>
						<tags>
							<tag>latest</tag>
						</tags>
					</to>
					<container>
						<ports>
							<port>8090</port>
						</ports>
						<!-- Container time is UTC; the app converts on the way out. -->
						<environment>
							<TZ>UTC</TZ>
						</environment>
					</container>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!--	JitPack builds a public GitHub repo on demand and serves it as a Maven artifact -
		no account, no publish workflow, no auth. Used for the AI Query SDK dependency
		above; see that dependency's own comment for why this replaced GitHub Packages.	-->
	<repositories>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
	</repositories>

</project>
